+﻿use ievr_cfg_bin_editor_core::Row;
+
+use crate::common::{parse_int_value, parse_number_value, parse_string_value};
+
+/// A special tactic, from SPECIAL_TACTICS_INFO_LIST. Names and descriptions
+/// live in item_text rather than skill_text: the game files these as items.
+pub struct Tactic {
+    pub(crate) tactic_id: i32,
+    pub(crate) string_id: String,
+    pub(crate) name_id: i32,
+    pub(crate) description_id: i32,
+    pub(crate) tp_cost: f32,
+    pub(crate) duration: f32,
+}
+
+impl Tactic {
+    pub const COLUMNS: usize = 17;
+    pub const ROW: &'static str = "SPECIAL_TACTICS_INFO";
+}
+
+impl From<&Row> for Tactic {
+    fn from(row: &Row) -> Self {
+        Tactic {
+            tactic_id: parse_int_value(&row.values[0][0]),
+            string_id: parse_string_value(&row.values[1][0]),
+            name_id: parse_int_value(&row.values[2][0]),
+            description_id: parse_int_value(&row.values[3][0]),
+            tp_cost: parse_number_value(&row.values[4][0]),
+            duration: parse_number_value(&row.values[5][0]),
+        }
+    }
+}
+
+/// A synergy, from ITEM_SYNERGY_FLAG_INFO_LIST in item_config. Column 16 is the
+/// id used by synergy_flag_config, which is the one worth exposing.
+pub struct Synergy {
+    pub(crate) synergy_id: i32,
+    pub(crate) item_id: i32,
+    pub(crate) string_id: String,
+    pub(crate) name_id: i32,
+    pub(crate) description_id: i32,
+}
+
+impl Synergy {
+    pub const COLUMNS: usize = 17;
+    pub const ROW: &'static str = "ITEM_SYNERGY_FLAG_INFO";
+}
+
+impl From<&Row> for Synergy {
+    fn from(row: &Row) -> Self {
+        Synergy {
+            synergy_id: parse_int_value(&row.values[16][0]),
+            item_id: parse_int_value(&row.values[0][0]),
+            string_id: parse_string_value(&row.values[11][0]),
+            name_id: parse_int_value(&row.values[2][0]),
+            description_id: parse_int_value(&row.values[3][0]),
+        }
+    }
+}
