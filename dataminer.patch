@@ -0,0 +1,95 @@
+﻿use ievr_cfg_bin_editor_core::Row;
+
+use crate::common::{parse_int_value, parse_number_value, parse_string_value};
+
+/// A row of PASSIVE_SKILL_INFO_LIST, in passive_skill_config.
+/// Since build 6.00.23.00 the passives no longer live in m_skillInfoList,
+/// which only holds categories 1 to 4 (shoot, dribble, defense, goalkeeper).
+pub struct Passive {
+    pub(crate) passive_id: i32,
+    pub(crate) name_id: i32,
+    pub(crate) link_id_1: i32,
+    pub(crate) link_id_2: i32,
+    pub(crate) category: i32,
+    pub(crate) rank_type: i32,
+    pub(crate) string_id: String,
+    /// Offset into PASSIVE_SKILL_EFFECT_LIST, from the REF_EFFECT sub row
+    pub(crate) effect_index: i32,
+    pub(crate) effect_count: i32,
+    /// The magnitude the <VALUE> placeholder in the name stands for
+    pub(crate) value: Option<f32>,
+    /// Icon the game shows for this passive, resolved through
+    /// PASSIVE_SKILL_BUFF_ICON_LIST. Its own numbering, not a file name.
+    pub(crate) buff_icon: Option<i32>,
+}
+
+impl Passive {
+    pub const COLUMNS: usize = 7;
+
+    /// Name of the row holding a passive itself
+    pub const ROW: &'static str = "PASSIVE_SKILL_INFO";
+    /// Name of the sub row pointing into PASSIVE_SKILL_EFFECT_LIST
+    pub const EFFECT_REF_ROW: &'static str = "PASSIVE_SKILL_INFO_REF_EFFECT";
+    /// Name of the sub row pointing into PASSIVE_SKILL_BUFF_ICON_LIST
+    pub const ICON_REF_ROW: &'static str = "PASSIVE_SKILL_INFO_REF_BUFF_ICON";
+}
+
+impl From<&Row> for Passive {
+    fn from(row: &Row) -> Self {
+        Passive {
+            passive_id: parse_int_value(&row.values[0][0]),
+            name_id: parse_int_value(&row.values[1][0]),
+            link_id_1: parse_int_value(&row.values[2][0]),
+            link_id_2: parse_int_value(&row.values[3][0]),
+            category: parse_int_value(&row.values[4][0]),
+            rank_type: parse_int_value(&row.values[5][0]),
+            string_id: parse_string_value(&row.values[6][0]),
+            buff_icon: None,
+            effect_index: -1,
+            effect_count: 0,
+            value: None,
+        }
+    }
+}
+
+/// One rarity step of a passive family, from m_passiveSkillRarityTableList
+/// in passive_skill_rarity_table_config. Each row holds up to
+/// [`PassiveTier::SLOTS`] ids, ordered from the base passive upwards, and is
+/// zero padded.
+pub struct PassiveTier {
+    pub(crate) family_index: i32,
+    pub(crate) tier: i32,
+    pub(crate) passive_id: i32,
+}
+
+impl PassiveTier {
+    pub const SLOTS: usize = 6;
+}
+
+/// A row of PASSIVE_SKILL_EFFECT_LIST. The effect ids do not join onto
+/// PASSIVE_SKILL_INFO_LIST, so the values are exposed as-is.
+pub struct PassiveEffect {
+    pub(crate) effect_id: i32,
+    pub(crate) value: f32,
+    pub(crate) params: [i32; 7],
+}
+
+impl PassiveEffect {
+    pub const COLUMNS: usize = 9;
+}
+
+impl From<&Row> for PassiveEffect {
+    fn from(row: &Row) -> Self {
+        let mut params = [0i32; 7];
+        for (i, param) in params.iter_mut().enumerate() {
+            *param = parse_int_value(&row.values[i + 2][0]);
+        }
+
+        PassiveEffect {
+            effect_id: parse_int_value(&row.values[0][0]),
+            value: parse_number_value(&row.values[1][0]),
+            params,
+        }
+    }
+}
+
