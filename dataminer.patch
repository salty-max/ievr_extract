@@ -0,0 +1,273 @@
+//! Resolving the `<PREFIX:KEY>` placeholders that non-Japanese text still carries.
+//!
+//! Japanese and both Chinese locales ship the literal text; every other locale leaves a
+//! placeholder for the game to fill in at runtime. Two config tables do the filling, both
+//! keyed by the CRC32 of the ASCII key:
+//!
+//! - `gamedata/character/chara_name_tag_*.cfg.bin` → `m_charaNameTagConfigList`,
+//!   `(crc, chara_base row id, _)`. `CRC32("ENDO")` lands on Mark Evans' row.
+//! - `gamedata/map/map_name_tag_*.cfg.bin` → `m_mapNameTagConfigList`, `(crc, map_text id)`.
+//!   This is what `MNT` — map name tag — uses, for places and clubs.
+//!
+//! The prefix picks which `chara_text` sub entry to read. Measured against the Japanese and
+//! Simplified Chinese text, which are already resolved, over ~700 placeholders: the nine
+//! character prefixes fall into three groups of three. Within a group they differ only in
+//! Japanese ruby typography — `FFC` groups the reading over the whole name where `FUL`
+//! leaves it split — which is invisible in a locale that has no ruby.
+
+use std::collections::HashMap;
+
+use ievr_cfg_bin_editor_core::Database;
+
+use crate::common::{parse_int_value, parse_uint_value};
+
+/// Column indices, build 6.00.23.00.
+///
+/// `chara_name_tag` rows are `(crc, chara_base row id, unused)`: column 1 holds row ids that
+/// match `chara_base` column 0 — `CRC32("ENDO")` = 2247885273 resolves to -1717452464, which
+/// is the `c01000010` row. `map_name_tag` rows are `(crc, text id)`: column 1 resolves in
+/// `map_text`, checked on `NAGUMOHARA` → South Cirrus / Nagumohara / 南雲原.
+const TAG_KEY: usize = 0;
+const TAG_TARGET: usize = 1;
+/// `chara_base` column 3 is the name id, the key into `chara_text`; 4 is the short name the
+/// pitch shows, 5 the same string uppercased for the shirt.
+const CHARA_BASE_ID: usize = 0;
+const CHARA_BASE_NAME_ID: usize = 3;
+const CHARA_BASE_SHORT_ID: usize = 4;
+const CHARA_BASE_UPPER_ID: usize = 5;
+
+/// Which `chara_text` sub entry a prefix reads. Sub 0 is the full name, 11 the family name,
+/// 12 the given name.
+fn sub_entry(prefix: &str) -> Option<i32> {
+    match prefix {
+        "FUL" | "FFC" | "LFC" => Some(0),
+        "LST" | "FLC" | "FLA" => Some(11),
+        "FST" | "FFS" | "LAF" => Some(12),
+        _ => None,
+    }
+}
+
+/// Locale grammar that the translators expressed as placeholders. These are registered in
+/// `chara_name_tag` with a target of 0 — they name no character. Only French and Italian use
+/// any; German, English, Spanish and Portuguese use none.
+enum Particle {
+    /// French picked the form by hand, against the Japanese name it was translating, so the
+    /// choice is already baked into which symbol was used.
+    Fixed(&'static str),
+    /// Italian names the alternatives in the symbol itself — `ad_a`, `il_l'` — and lets the
+    /// following word decide.
+    Elided {
+        before_vowel: &'static str,
+        otherwise: &'static str,
+    },
+}
+
+enum Replacement {
+    Character { name_id: i32 },
+    Place { text_id: i32 },
+    Grammar(Particle),
+    /// A few symbols are registered with no usable target: `TANAKA` points at 1074139552,
+    /// which appears in no text file in any language, and `SHIROYAMA` / `YAMADA` carry a
+    /// target of 0 like the particles do. Every symbol key is the uppercase romaji of the
+    /// name it stands for — proven on ENDO, GOENJI, TSURUGI, which all come from `chara_base`
+    /// column 5 read through `chara_text_roma` — and the Japanese confirms the reading
+    /// (田中, 白山, 山田), so title-casing the key is a derivation, not an invention.
+    Literal(&'static str),
+}
+
+pub struct TagError {
+    pub key: String,
+    pub line: String,
+}
+
+pub struct NameTags {
+    symbols: HashMap<u32, Replacement>,
+    /// Every `chara_text` entry a character points at: the full name in column 3, the short
+    /// name the pitch shows in column 4, its uppercase twin in column 5. Downstream needs all
+    /// three resolved, and re-reading the raw config to get them is how placeholders came back.
+    referenced_names: Vec<i32>,
+}
+
+fn crc32(bytes: &[u8]) -> u32 {
+    let mut crc = 0xFFFF_FFFFu32;
+    for &byte in bytes {
+        crc ^= byte as u32;
+        for _ in 0..8 {
+            crc = if crc & 1 != 0 {
+                0xEDB8_8320 ^ (crc >> 1)
+            } else {
+                crc >> 1
+            };
+        }
+    }
+    !crc
+}
+
+impl NameTags {
+    pub fn load(chara_name_tag: &Database, map_name_tag: &Database, chara_base: &Database) -> Self {
+        // chara_base row id -> the name id the text tables use
+        let mut name_id_of_row = HashMap::new();
+        let mut referenced_names = Vec::new();
+        let chara_base_table = chara_base.table("CHARA_BASE_INFO_LIST").unwrap();
+        for row in chara_base_table.rows() {
+            if row.values.len() < 34 {
+                continue;
+            }
+            let id = parse_int_value(&row.values[CHARA_BASE_ID][0]);
+            let name_id = parse_int_value(&row.values[CHARA_BASE_NAME_ID][0]);
+            name_id_of_row.entry(id).or_insert(name_id);
+
+            for column in [CHARA_BASE_NAME_ID, CHARA_BASE_SHORT_ID, CHARA_BASE_UPPER_ID] {
+                let value = parse_int_value(&row.values[column][0]);
+                if value != 0 {
+                    referenced_names.push(value);
+                }
+            }
+        }
+        referenced_names.sort_unstable();
+        referenced_names.dedup();
+
+        let mut symbols = HashMap::new();
+
+        let chara_table = chara_name_tag.table("m_charaNameTagConfigList").unwrap();
+        for row in chara_table.rows() {
+            if row.values.len() < 3 {
+                continue;
+            }
+            let key = parse_uint_value(&row.values[TAG_KEY][0]);
+            let target = parse_uint_value(&row.values[TAG_TARGET][0]).cast_signed();
+
+            // A target of 0 means the symbol stands for grammar, not a person
+            if target == 0 {
+                continue;
+            }
+            if let Some(&name_id) = name_id_of_row.get(&target) {
+                symbols.insert(key, Replacement::Character { name_id });
+            }
+        }
+
+        let map_table = map_name_tag.table("m_mapNameTagConfigList").unwrap();
+        for row in map_table.rows() {
+            if row.values.len() < 2 {
+                continue;
+            }
+            let key = parse_uint_value(&row.values[TAG_KEY][0]);
+            let text_id = parse_uint_value(&row.values[TAG_TARGET][0]).cast_signed();
+            symbols.insert(key, Replacement::Place { text_id });
+        }
+
+        for (key, particle) in [
+            ("DE1", Particle::Fixed("d'")),
+            ("DE2", Particle::Fixed("de ")),
+            ("QUE1", Particle::Fixed("qu'")),
+            ("QUE2", Particle::Fixed("que ")),
+            (
+                "ad_a",
+                Particle::Elided { before_vowel: "ad ", otherwise: "a " },
+            ),
+            (
+                "il_l'",
+                Particle::Elided { before_vowel: "l'", otherwise: "il " },
+            ),
+        ] {
+            symbols.insert(crc32(key.as_bytes()), Replacement::Grammar(particle));
+        }
+
+        for (key, name) in [
+            ("TANAKA", "Tanaka"),
+            ("SHIROYAMA", "Shiroyama"),
+            ("YAMADA", "Yamada"),
+        ] {
+            symbols.insert(crc32(key.as_bytes()), Replacement::Literal(name));
+        }
+
+        NameTags { symbols, referenced_names }
+    }
+
+    pub fn referenced_names(&self) -> &[i32] {
+        &self.referenced_names
+    }
+
+    /// Replace every placeholder in `line`. Returns the offending key rather than dropping it,
+    /// because a silent fallback is what let this go unnoticed in the first place.
+    pub fn resolve(
+        &self,
+        line: &str,
+        names: &HashMap<(i32, i32), String>,
+        places: &HashMap<i32, String>,
+    ) -> Result<String, TagError> {
+        if !line.contains('<') {
+            return Ok(line.to_string());
+        }
+
+        // Elisions need to see what follows, so build pieces first and join afterwards
+        enum Piece<'a> {
+            Text(String),
+            Elision { before_vowel: &'a str, otherwise: &'a str },
+        }
+        let mut pieces: Vec<Piece> = Vec::new();
+        let mut rest = line;
+
+        while let Some(open) = rest.find('<') {
+            let Some(close_offset) = rest[open..].find('>') else { break };
+            let close = open + close_offset;
+            let inside = &rest[open + 1..close];
+
+            let Some((prefix, key)) = inside.split_once(':') else {
+                // Not one of ours — markup like [kanji/kana] never uses angle brackets
+                pieces.push(Piece::Text(rest[..=close].to_string()));
+                rest = &rest[close + 1..];
+                continue;
+            };
+
+            pieces.push(Piece::Text(rest[..open].to_string()));
+
+            let fail = || TagError { key: inside.to_string(), line: line.to_string() };
+            let replacement = self.symbols.get(&crc32(key.as_bytes())).ok_or_else(fail)?;
+
+            match replacement {
+                Replacement::Grammar(Particle::Fixed(text)) => {
+                    pieces.push(Piece::Text((*text).to_string()))
+                }
+                Replacement::Grammar(Particle::Elided { before_vowel, otherwise }) => {
+                    pieces.push(Piece::Elision { before_vowel, otherwise })
+                }
+                Replacement::Literal(text) => pieces.push(Piece::Text((*text).to_string())),
+                Replacement::Place { text_id } => {
+                    let name = places.get(text_id).ok_or_else(fail)?;
+                    pieces.push(Piece::Text(name.clone()))
+                }
+                Replacement::Character { name_id } => {
+                    let sub = sub_entry(prefix).ok_or_else(fail)?;
+                    let name = names.get(&(*name_id, sub)).ok_or_else(fail)?;
+                    pieces.push(Piece::Text(name.clone()))
+                }
+            }
+
+            rest = &rest[close + 1..];
+        }
+        pieces.push(Piece::Text(rest.to_string()));
+
+        let mut out = String::with_capacity(line.len());
+        for index in 0..pieces.len() {
+            match &pieces[index] {
+                Piece::Text(text) => out.push_str(text),
+                Piece::Elision { before_vowel, otherwise } => {
+                    let next = pieces[index + 1..].iter().find_map(|p| match p {
+                        Piece::Text(t) if !t.is_empty() => t.chars().next(),
+                        _ => None,
+                    });
+                    let vowel = next.is_some_and(|c| {
+                        matches!(
+                            c.to_ascii_uppercase(),
+                            'A' | 'E' | 'I' | 'O' | 'U' | 'H'
+                        )
+                    });
+                    out.push_str(if vowel { before_vowel } else { otherwise });
+                }
+            }
+        }
+
+        Ok(out)
+    }
+}
