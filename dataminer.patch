@@ -0,0 +1,49 @@
+use ievr_cfg_bin_editor_core::Row;
+
+use crate::common::{parse_int_value, parse_string_value};
+
+/// A piece of equipment from item_config. The game splits them across one table
+/// per slot, all with the same shape: an INFO row carrying the identifiers, then
+/// a REGULAR_UNIQUE_BASE sub row carrying the stat bonuses.
+pub struct Equipment {
+    pub(crate) item_id: i32,
+    pub(crate) slot: &'static str,
+    pub(crate) string_id: String,
+    pub(crate) name_id: i32,
+    pub(crate) description_id: i32,
+    pub(crate) stats: [i32; Equipment::STATS],
+}
+
+impl Equipment {
+    pub const COLUMNS: usize = 19;
+    pub const STATS: usize = 7;
+
+    /// table, slot, info row, stat sub row
+    pub const SLOTS: [(&'static str, &'static str, &'static str, &'static str); 4] = [
+        ("ITEM_SHOES_INFO_LIST", "boots", "ITEM_SHOES_INFO", "ITEM_SHOES_INFO_REGULAR_UNIQUE_BASE"),
+        ("ITEM_MISANGA_INFO_LIST", "bracelet", "ITEM_MISANGA_INFO", "ITEM_MISANGA_INFO_REGULAR_UNIQUE_BASE"),
+        ("ITEM_ACCESSORY_INFO_LIST", "pendant", "ITEM_ACCESSORY_INFO", "ITEM_ACCESSORY_INFO_REGULAR_UNIQUE_BASE"),
+        ("ITEM_SPECIAL_INFO_LIST", "special", "ITEM_SPECIAL_INFO", "ITEM_SPECIAL_INFO_REGULAR_UNIQUE_BASE"),
+    ];
+
+    pub fn from_row(row: &Row, slot: &'static str) -> Self {
+        Equipment {
+            item_id: parse_int_value(&row.values[0][0]),
+            slot,
+            string_id: parse_string_value(&row.values[11][0]),
+            name_id: parse_int_value(&row.values[2][0]),
+            description_id: parse_int_value(&row.values[3][0]),
+            stats: [0; Equipment::STATS],
+        }
+    }
+
+    /// Stat order matches the character tables: kick, control, technique,
+    /// pressure, physical, agility, intelligence.
+    pub fn read_stats(&mut self, row: &Row) {
+        for (i, stat) in self.stats.iter_mut().enumerate() {
+            if let Some(value) = row.values.get(i) {
+                *stat = parse_int_value(&value[0]);
+            }
+        }
+    }
+}
