@@ -0,0 +1,23 @@
+use std::env;
+use std::fs;
+
+use ievr_cfg_bin_editor_core::parse_database;
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 3 {
+        eprintln!("usage: dump_schema <file.cfg.bin> <out.json>");
+        std::process::exit(1);
+    }
+
+    let bytes = fs::read(&args[1]).expect("could not read file");
+    let db = parse_database(&bytes).expect("could not parse database");
+
+    for t in db.tables() {
+        eprintln!("  {}  ({} rows)", t.name(), t.rows().len());
+    }
+
+    let json = db.serialize().expect("serialize failed");
+    fs::write(&args[2], json).expect("write failed");
+    eprintln!("written to {}", args[2]);
+}
diff --git a/src/bin/export_json.rs b/src/bin/export_json.rs
new file mode 100644
index 0000000..81a9b4f
--- /dev/null
+++ b/src/bin/export_json.rs
@@ -0,0 +1,374 @@
+﻿use std::env;
+use std::fs;
+use std::path::Path;
+
+use rusqlite::{Connection, Row};
+use serde_json::{Map, Value, json};
+
+const LANGUAGES: [&str; 3] = ["en", "fr", "ja"];
+
+/// Emblem fields hold the CRC32 of the texture's file name, so the shipped
+/// files have to be hashed to be matched back.
+fn crc32(name: &str) -> i32 {
+    let mut table = [0u32; 256];
+    for (i, entry) in table.iter_mut().enumerate() {
+        let mut c = i as u32;
+        for _ in 0..8 {
+            c = if c & 1 != 0 { (c >> 1) ^ 0xEDB8_8320 } else { c >> 1 };
+        }
+        *entry = c;
+    }
+
+    let mut crc = 0xFFFF_FFFFu32;
+    for b in name.as_bytes() {
+        crc = (crc >> 8) ^ table[((crc ^ *b as u32) & 0xFF) as usize];
+    }
+    (!crc) as i32
+}
+
+fn emblem_index(dir: Option<&String>) -> std::collections::HashMap<i32, String> {
+    let mut map = std::collections::HashMap::new();
+    let Some(dir) = dir else { return map };
+    let Ok(entries) = fs::read_dir(dir) else { return map };
+
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.extension().is_some_and(|e| e == "png") {
+            let stem = path.file_stem().unwrap().to_string_lossy().to_string();
+            map.insert(crc32(&stem), stem);
+        }
+    }
+    map
+}
+
+/// Japanese text marks readings as [kanji/kana]; this keeps only the kanji.
+fn strip_furigana(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut rest = text;
+
+    while let Some(start) = rest.find('[') {
+        let Some(close) = rest[start..].find(']') else { break };
+        let inner = &rest[start + 1..start + close];
+
+        let Some(slash) = inner.find('/') else {
+            out.push_str(&rest[..start + close + 1]);
+            rest = &rest[start + close + 1..];
+            continue;
+        };
+
+        out.push_str(&rest[..start]);
+        out.push_str(&inner[..slash]);
+        rest = &rest[start + close + 1..];
+    }
+
+    out.push_str(rest);
+    out
+}
+
+/// Emits `field`, plus `field_plain` when the string carries furigana markup.
+fn text_fields(target: &mut Map<String, Value>, field: &str, text: Option<String>) {
+    let Some(text) = text else {
+        target.insert(field.to_string(), Value::Null);
+        return;
+    };
+
+    let plain = strip_furigana(&text);
+    if plain != text {
+        target.insert(format!("{field}_plain"), json!(plain));
+    }
+    target.insert(field.to_string(), json!(text));
+}
+
+fn stat_block(row: &Row, prefix: &str) -> Value {
+    let get = |name: &str| -> Value {
+        row.get::<_, Option<i64>>(format!("{prefix}_{name}").as_str())
+            .ok()
+            .flatten()
+            .map(|v| json!(v))
+            .unwrap_or(Value::Null)
+    };
+
+    json!({
+        "kick": get("kick"),
+        "control": get("control"),
+        "technique": get("technique"),
+        "pressure": get("pressure"),
+        "physical": get("physical"),
+        "agility": get("agility"),
+        "intelligence": get("intelligence"),
+    })
+}
+
+fn characters(
+    conn: &Connection,
+    lang: &str,
+    table: &str,
+    emblems: &std::collections::HashMap<i32, String>,
+) -> rusqlite::Result<Vec<Value>> {
+    let sql = format!(
+        "SELECT c.*, n.name AS loc_name, r.name AS orig_name, d.description AS descr,
+                s.name AS series, tn.name AS team, ct.team_id AS team_id,
+                t.emblem_v AS em_v, t.emblem_ie AS em_ie, t.emblem_go AS em_go,
+                t.emblem_areori AS em_ar
+         FROM {table} c
+         LEFT JOIN character_names      n ON n.id = c.name_id        AND n.lang = ?1
+         LEFT JOIN character_names_roma r ON r.id = c.name_id        AND r.lang = ?1
+         LEFT JOIN character_descriptions d ON d.id = c.description_id AND d.lang = ?1
+         LEFT JOIN series_names         s ON s.id = c.series_id      AND s.lang = ?1
+         LEFT JOIN character_teams     ct ON ct.index_id = c.index_id
+         LEFT JOIN teams                t ON t.team_id = ct.team_id
+         LEFT JOIN team_names          tn ON tn.id = t.name_id       AND tn.lang = ?1"
+    );
+
+    let mut stmt = conn.prepare(&sql)?;
+    let rows = stmt.query_map([lang], |row| {
+        let mut object = Map::new();
+        object.insert("id".into(), json!(row.get::<_, i64>("index_id")?));
+        // Game string id (`c01000010`) — Inazugle's 3D-model / viewer key.
+        if let Ok(character_id) = row.get::<_, String>("character_id") {
+            if !character_id.is_empty() {
+                object.insert("character_id".into(), json!(character_id));
+            }
+        }
+
+        // The game lets you show original Japanese player names in any language
+        text_fields(&mut object, "name", row.get::<_, Option<String>>("loc_name")?);
+        text_fields(&mut object, "name_original", row.get::<_, Option<String>>("orig_name")?);
+        text_fields(&mut object, "description", row.get::<_, Option<String>>("descr")?);
+        text_fields(&mut object, "series", row.get::<_, Option<String>>("series")?);
+        text_fields(&mut object, "team", row.get::<_, Option<String>>("team")?);
+        object.insert("team_id".into(), json!(row.get::<_, Option<i64>>("team_id")?));
+
+        // Victory Road's own emblem first, then the earlier eras: only a third
+        // of the clubs ship a V one, so V alone would leave most players blank.
+        // `emblem_era` says which one was actually picked.
+        let lookup = |column: &str| -> Option<String> {
+            row.get::<_, Option<i64>>(column)
+                .ok()
+                .flatten()
+                .and_then(|v| emblems.get(&(v as i32)).cloned())
+        };
+
+        let (emblem, era) = [("v", "em_v"), ("ie", "em_ie"), ("go", "em_go"), ("areori", "em_ar")]
+            .iter()
+            .find_map(|(era, column)| lookup(column).map(|file| (file, *era)))
+            .map_or((None, None), |(file, era)| (Some(file), Some(era)));
+
+        object.insert("emblem".into(), json!(emblem));
+        object.insert("emblem_era".into(), json!(era));
+
+        for field in ["element", "main_position", "alt_position", "style"] {
+            object.insert(field.into(), json!(row.get::<_, Option<i64>>(field)?));
+        }
+
+        object.insert("stats_lv50".into(), stat_block(row, "lvl50"));
+        object.insert("stats_lv99".into(), stat_block(row, "lvl99"));
+
+        Ok(Value::Object(object))
+    })?;
+
+    rows.collect()
+}
+
+fn skills(conn: &Connection, lang: &str, table: &str) -> rusqlite::Result<Vec<Value>> {
+    let sql = format!(
+        "SELECT k.*, s.name AS sname, s.description AS sdesc
+         FROM {table} k
+         LEFT JOIN skill_names s ON s.id = k.name_id AND s.lang = ?1"
+    );
+
+    let mut stmt = conn.prepare(&sql)?;
+    let rows = stmt.query_map([lang], |row| {
+        let mut object = Map::new();
+        object.insert("id".into(), json!(row.get::<_, i64>("skill_id")?));
+        text_fields(&mut object, "name", row.get::<_, Option<String>>("sname")?);
+        text_fields(&mut object, "description", row.get::<_, Option<String>>("sdesc")?);
+
+        for field in [
+            "power", "element", "category", "growth_rate", "tp_consumption", "cooldown",
+        ] {
+            object.insert(field.into(), json!(row.get::<_, Option<i64>>(field)?));
+        }
+        for field in ["is_block", "is_longshot"] {
+            object.insert(field.into(), json!(row.get::<_, Option<bool>>(field)?));
+        }
+
+        Ok(Value::Object(object))
+    })?;
+
+    rows.collect()
+}
+
+fn auras(conn: &Connection, lang: &str) -> rusqlite::Result<Vec<Value>> {
+    let mut stmt = conn.prepare(
+        "SELECT a.*, s.name AS sname, s.description AS sdesc
+         FROM aura a
+         LEFT JOIN skill_names s ON s.id = a.name_id AND s.lang = ?1",
+    )?;
+
+    let rows = stmt.query_map([lang], |row| {
+        let mut object = Map::new();
+        object.insert("id".into(), json!(row.get::<_, i64>("aura_id")?));
+        text_fields(&mut object, "name", row.get::<_, Option<String>>("sname")?);
+        text_fields(&mut object, "description", row.get::<_, Option<String>>("sdesc")?);
+        object.insert("skill_id".into(), json!(row.get::<_, Option<i64>>("skill_id")?));
+        object.insert("element".into(), json!(row.get::<_, Option<i64>>("element")?));
+        Ok(Value::Object(object))
+    })?;
+
+    rows.collect()
+}
+
+fn passives(conn: &Connection, lang: &str) -> rusqlite::Result<Vec<Value>> {
+    // A passive can belong to several rarity families, so the tiers are
+    // collected first and attached as a list to keep one entry per passive.
+    let mut tiers: std::collections::HashMap<i64, Vec<Value>> = std::collections::HashMap::new();
+    {
+        let mut stmt =
+            conn.prepare("SELECT passive_id, family_index, tier FROM passive_rarity_tiers")?;
+        let mut rows = stmt.query([])?;
+        while let Some(row) = rows.next()? {
+            tiers
+                .entry(row.get("passive_id")?)
+                .or_default()
+                .push(json!({ "family": row.get::<_, i64>("family_index")?, "tier": row.get::<_, i64>("tier")? }));
+        }
+    }
+
+    let mut stmt = conn.prepare(
+        "SELECT p.*, s.name AS sname
+         FROM passive_skills p
+         LEFT JOIN skill_names s ON s.id = p.name_id AND s.lang = ?1",
+    )?;
+
+    let rows = stmt.query_map([lang], |row| {
+        let id: i64 = row.get("passive_id")?;
+
+        let mut object = Map::new();
+        object.insert("id".into(), json!(id));
+        object.insert("string_id".into(), json!(row.get::<_, String>("string_id")?));
+        text_fields(&mut object, "name", row.get::<_, Option<String>>("sname")?);
+        object.insert("value".into(), json!(row.get::<_, Option<f64>>("value")?));
+        object.insert("category".into(), json!(row.get::<_, i64>("category")?));
+        object.insert("buff_icon".into(), json!(row.get::<_, Option<i64>>("buff_icon")?));
+        object.insert("tiers".into(), json!(tiers.get(&id).cloned().unwrap_or_default()));
+        Ok(Value::Object(object))
+    })?;
+
+    rows.collect()
+}
+
+fn tactics(conn: &Connection, lang: &str) -> rusqlite::Result<Vec<Value>> {
+    let mut stmt = conn.prepare(
+        "SELECT t.*, n.name AS tname, d.description AS tdesc
+         FROM tactics t
+         LEFT JOIN item_names        n ON n.id = t.name_id        AND n.lang = ?1
+         LEFT JOIN item_descriptions d ON d.id = t.description_id AND d.lang = ?1",
+    )?;
+
+    let rows = stmt.query_map([lang], |row| {
+        let mut object = Map::new();
+        object.insert("id".into(), json!(row.get::<_, i64>("tactic_id")?));
+        object.insert("string_id".into(), json!(row.get::<_, String>("string_id")?));
+        text_fields(&mut object, "name", row.get::<_, Option<String>>("tname")?);
+        text_fields(&mut object, "description", row.get::<_, Option<String>>("tdesc")?);
+        object.insert("tp_cost".into(), json!(row.get::<_, f64>("tp_cost")?));
+                Ok(Value::Object(object))
+    })?;
+
+    rows.collect()
+}
+
+fn synergies(conn: &Connection, lang: &str) -> rusqlite::Result<Vec<Value>> {
+    let mut stmt = conn.prepare(
+        "SELECT s.*, n.name AS sname, d.description AS sdesc
+         FROM synergies s
+         LEFT JOIN item_names        n ON n.id = s.name_id        AND n.lang = ?1
+         LEFT JOIN item_descriptions d ON d.id = s.description_id AND d.lang = ?1",
+    )?;
+
+    let rows = stmt.query_map([lang], |row| {
+        let mut object = Map::new();
+        object.insert("id".into(), json!(row.get::<_, i64>("synergy_id")?));
+        object.insert("string_id".into(), json!(row.get::<_, String>("string_id")?));
+        text_fields(&mut object, "name", row.get::<_, Option<String>>("sname")?);
+        text_fields(&mut object, "description", row.get::<_, Option<String>>("sdesc")?);
+                Ok(Value::Object(object))
+    })?;
+
+    rows.collect()
+}
+
+fn equipment(conn: &Connection, lang: &str) -> rusqlite::Result<Vec<Value>> {
+    let mut stmt = conn.prepare(
+        "SELECT e.*, n.name AS ename, d.description AS edesc
+         FROM equipment e
+         LEFT JOIN item_names        n ON n.id = e.name_id        AND n.lang = ?1
+         LEFT JOIN item_descriptions d ON d.id = e.description_id AND d.lang = ?1",
+    )?;
+
+    let rows = stmt.query_map([lang], |row| {
+        let mut object = Map::new();
+        object.insert("id".into(), json!(row.get::<_, i64>("item_id")?));
+        object.insert("slot".into(), json!(row.get::<_, String>("slot")?));
+        object.insert("string_id".into(), json!(row.get::<_, String>("string_id")?));
+        text_fields(&mut object, "name", row.get::<_, Option<String>>("ename")?);
+        text_fields(&mut object, "description", row.get::<_, Option<String>>("edesc")?);
+
+        let mut stats = Map::new();
+        for stat in ["kick", "control", "technique", "pressure", "physical", "agility", "intelligence"] {
+            stats.insert(stat.into(), json!(row.get::<_, i64>(stat)?));
+        }
+        object.insert("stats".into(), Value::Object(stats));
+
+        Ok(Value::Object(object))
+    })?;
+
+    rows.collect()
+}
+
+fn main() -> rusqlite::Result<()> {
+    let args: Vec<String> = env::args().collect();
+    let out_dir = args.get(1).map(String::as_str).unwrap_or("output");
+
+    let emblems = emblem_index(args.get(2));
+    println!("emblemes indexes : {}", emblems.len());
+
+    let conn = Connection::open(Path::new(out_dir).join("ievr.sqlite"))?;
+    let json_dir = Path::new(out_dir).join("json");
+    fs::create_dir_all(&json_dir).unwrap();
+
+    for lang in LANGUAGES {
+        let bundle = json!({
+            "lang": lang,
+            "game_version": "6.00.23.00",
+            "legend": {
+                "element": { "1": "wind", "2": "forest", "3": "fire", "4": "mountain", "5": "unknown" },
+                "note": "main_position, alt_position, style and category are raw game codes"
+            },
+            "characters": characters(&conn, lang, "characters", &emblems)?,
+            "heroes": characters(&conn, lang, "heroes", &emblems)?,
+            "basaras": characters(&conn, lang, "basaras", &emblems)?,
+            "hissatsu": skills(&conn, lang, "hissatsu")?,
+            "aura_hissatsu": skills(&conn, lang, "aura_hissatsu")?,
+            "auras": auras(&conn, lang)?,
+            "passives": passives(&conn, lang)?,
+            "tactics": tactics(&conn, lang)?,
+            "synergies": synergies(&conn, lang)?,
+            "equipment": equipment(&conn, lang)?,
+        });
+
+        let path = json_dir.join(format!("ievr.{lang}.json"));
+        fs::write(&path, serde_json::to_string(&bundle).unwrap()).unwrap();
+
+        let size = fs::metadata(&path).unwrap().len();
+        println!("  {:<22} {:>7.2} MB", path.display().to_string(), size as f64 / 1e6);
+    }
+
+    Ok(())
+}
+
+
+
+
+
diff --git a/src/bin/find_ids.rs b/src/bin/find_ids.rs
new file mode 100644
index 0000000..5a8b17f
--- /dev/null
+++ b/src/bin/find_ids.rs
@@ -0,0 +1,80 @@
+use std::collections::HashSet;
+use std::env;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use ievr_cfg_bin_editor_core::{Value, parse_database};
+
+fn as_id(v: &Value) -> Option<i32> {
+    match v {
+        Value::Int(x) => Some(*x),
+        Value::UInt(x) => Some(x.cast_signed()),
+        Value::Hash(x) => Some(x.cast_signed()),
+        _ => None,
+    }
+}
+
+fn walk(dir: &Path, out: &mut Vec<PathBuf>) {
+    let Ok(entries) = fs::read_dir(dir) else { return };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.is_dir() {
+            walk(&path, out);
+        } else if path.to_string_lossy().ends_with(".cfg.bin") {
+            out.push(path);
+        }
+    }
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 3 {
+        eprintln!("usage: find_ids <ids.txt> <root_dir>");
+        std::process::exit(1);
+    }
+
+    let targets: HashSet<i32> = fs::read_to_string(&args[1])
+        .expect("could not read ids")
+        .lines()
+        .filter_map(|l| l.trim().parse::<i32>().ok())
+        .collect();
+
+    println!("looking for {} ids", targets.len());
+
+    let mut files = Vec::new();
+    walk(Path::new(&args[2]), &mut files);
+    println!("scanning {} cfg.bin files\n", files.len());
+
+    for file in files {
+        let Ok(bytes) = fs::read(&file) else { continue };
+
+        // parse_database panics on unknown formats, so isolate it
+        let parsed = std::panic::catch_unwind(|| parse_database(&bytes));
+        let Ok(Ok(db)) = parsed else { continue };
+
+        for table in db.tables() {
+            let mut found = HashSet::new();
+            for row in table.rows() {
+                for col in &row.values {
+                    for value in col {
+                        if let Some(id) = as_id(value) {
+                            if targets.contains(&id) {
+                                found.insert(id);
+                            }
+                        }
+                    }
+                }
+            }
+
+            if !found.is_empty() {
+                println!(
+                    "{:>5} / {}  {}  ->  {}",
+                    found.len(),
+                    targets.len(),
+                    file.display(),
+                    table.name()
+                );
+            }
+        }
+    }
+}
diff --git a/src/bin/g4tx_to_png.rs b/src/bin/g4tx_to_png.rs
new file mode 100644
index 0000000..13b9ebd
--- /dev/null
+++ b/src/bin/g4tx_to_png.rs
@@ -0,0 +1,122 @@
+//! Converts Level-5 `.g4tx` textures to PNG.
+//!
+//! A `.g4tx` is a thin wrapper: a `G4TX` header of variable length followed by a
+//! standard DDS. The DDS offset is not fixed, so the magic is searched for
+//! rather than assumed. Textures in this game are BC7, which needs a real block
+//! decoder — `image`'s DDS support only covers BC1/2/3.
+
+use std::env;
+use std::fs::{self, File};
+use std::io::BufWriter;
+use std::path::{Path, PathBuf};
+
+fn u32_at(data: &[u8], offset: usize) -> u32 {
+    u32::from_le_bytes([data[offset], data[offset + 1], data[offset + 2], data[offset + 3]])
+}
+
+fn find_dds(data: &[u8]) -> Option<usize> {
+    data.windows(4).position(|w| w == b"DDS ")
+}
+
+fn walk(dir: &Path, out: &mut Vec<PathBuf>) {
+    let Ok(entries) = fs::read_dir(dir) else { return };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.is_dir() {
+            walk(&path, out);
+        } else if path.extension().is_some_and(|e| e == "g4tx") {
+            out.push(path);
+        }
+    }
+}
+
+/// texture2ddecoder yields 0xAARRGGBB words; PNG wants straight RGBA bytes.
+fn argb_to_rgba(pixels: &[u32]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(pixels.len() * 4);
+    for p in pixels {
+        out.push((p >> 16) as u8);
+        out.push((p >> 8) as u8);
+        out.push(*p as u8);
+        out.push((p >> 24) as u8);
+    }
+    out
+}
+
+fn convert(path: &Path, out_root: &Path, in_root: &Path) -> Result<(usize, usize), String> {
+    let data = fs::read(path).map_err(|e| e.to_string())?;
+    let dds = find_dds(&data).ok_or("no DDS payload")?;
+
+    let height = u32_at(&data, dds + 12) as usize;
+    let width = u32_at(&data, dds + 16) as usize;
+    let four_cc = &data[dds + 84..dds + 88];
+
+    let (format, pixels_at) = if four_cc == b"DX10" {
+        (u32_at(&data, dds + 128), dds + 148)
+    } else {
+        let tag = String::from_utf8_lossy(four_cc).to_string();
+        return Err(format!("unhandled FourCC {tag}"));
+    };
+
+    let payload = &data[pixels_at..];
+    let mut buffer = vec![0u32; width * height];
+
+    match format {
+        98 | 99 => texture2ddecoder::decode_bc7(payload, width, height, &mut buffer)
+            .map_err(|e| format!("bc7: {e}"))?,
+        77 | 78 => texture2ddecoder::decode_bc3(payload, width, height, &mut buffer)
+            .map_err(|e| format!("bc3: {e}"))?,
+        71 | 72 => texture2ddecoder::decode_bc1(payload, width, height, &mut buffer)
+            .map_err(|e| format!("bc1: {e}"))?,
+        other => return Err(format!("unhandled DXGI format {other}")),
+    }
+
+    let relative = path.strip_prefix(in_root).unwrap_or(path);
+    let target = out_root.join(relative).with_extension("png");
+    fs::create_dir_all(target.parent().unwrap()).map_err(|e| e.to_string())?;
+
+    let file = File::create(&target).map_err(|e| e.to_string())?;
+    let mut encoder = png::Encoder::new(BufWriter::new(file), width as u32, height as u32);
+    encoder.set_color(png::ColorType::Rgba);
+    encoder.set_depth(png::BitDepth::Eight);
+
+    encoder
+        .write_header()
+        .map_err(|e| e.to_string())?
+        .write_image_data(&argb_to_rgba(&buffer))
+        .map_err(|e| e.to_string())?;
+
+    Ok((width, height))
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 3 {
+        eprintln!("usage: g4tx_to_png <input_dir> <output_dir>");
+        std::process::exit(1);
+    }
+
+    let in_root = Path::new(&args[1]);
+    let out_root = Path::new(&args[2]);
+
+    let mut files = Vec::new();
+    walk(in_root, &mut files);
+    files.sort();
+
+    let mut ok = 0;
+    let mut failed = 0;
+
+    for file in &files {
+        match convert(file, out_root, in_root) {
+            Ok((w, h)) => {
+                ok += 1;
+                println!("  {:>5}x{:<5} {}", w, h, file.strip_prefix(in_root).unwrap_or(file).display());
+            }
+            Err(e) => {
+                failed += 1;
+                eprintln!("  FAILED {} : {e}", file.display());
+            }
+        }
+    }
+
+    println!("\n{ok} converted, {failed} failed");
+}
diff --git a/src/bin/merge_db.rs b/src/bin/merge_db.rs
new file mode 100644
index 0000000..84f03ef
--- /dev/null
+++ b/src/bin/merge_db.rs
@@ -0,0 +1,131 @@
+﻿use std::env;
+use std::fs;
+use std::path::Path;
+
+use rusqlite::Connection;
+
+const LANGUAGES: [&str; 9] = ["de", "en", "es", "fr", "it", "ja", "pt", "zh_hans", "zh_hant"];
+
+/// Text tables are per language upstream; here they get a `lang` column.
+const TEXT_TABLES: [(&str, &str); 11] = [
+    ("character_names", "id, name"),
+    ("character_names_roma", "id, name"),
+    ("character_descriptions", "id, description"),
+    ("character_name_parts", "id, part, text"),
+    ("skill_names", "id, name, description"),
+    ("series_names", "id, name"),
+    ("team_names", "id, name"),
+    ("item_names", "id, name"),
+    ("item_descriptions", "id, description"),
+    ("place_names", "id, name"),
+    ("location_names", "id, name"),
+];
+
+fn main() -> rusqlite::Result<()> {
+    let args: Vec<String> = env::args().collect();
+    let out_dir = args.get(1).map(String::as_str).unwrap_or("output");
+    let target = Path::new(out_dir).join("ievr.sqlite");
+
+    let _ = fs::remove_file(&target);
+    let conn = Connection::open(&target)?;
+
+    conn.pragma_update(None, "journal_mode", "OFF")?;
+    conn.pragma_update(None, "synchronous", "OFF")?;
+
+    // Character and skill tables copy over unchanged
+    for (file, tables) in [
+        (
+            "characters.sqlite",
+            vec!["characters", "heroes", "basaras", "teams", "character_teams"],
+        ),
+        (
+            "skills.sqlite",
+            vec![
+                "hissatsu",
+                "aura_hissatsu",
+                "aura",
+                "passives",
+                "passive_skills",
+                "passive_rarity_tiers",
+                "passive_skill_effects",
+                "tactics",
+                "synergies",
+                "equipment",
+            ],
+        ),
+    ] {
+        let path = Path::new(out_dir).join(file);
+        conn.execute("ATTACH DATABASE ?1 AS src", [path.to_string_lossy()])?;
+
+        for table in tables {
+            conn.execute_batch(&format!(
+                "CREATE TABLE {table} AS SELECT * FROM src.{table};"
+            ))?;
+            let n: i64 = conn.query_row(&format!("SELECT COUNT(*) FROM {table}"), [], |r| r.get(0))?;
+            println!("  {table:<24} {n} rows");
+        }
+
+        conn.execute_batch("DETACH DATABASE src;")?;
+    }
+
+    // Text tables get folded together, one row per language
+    conn.execute_batch(
+        "CREATE TABLE character_names        (lang TEXT NOT NULL, id INTEGER NOT NULL, name TEXT NOT NULL, PRIMARY KEY (lang, id));
+         CREATE TABLE character_names_roma   (lang TEXT NOT NULL, id INTEGER NOT NULL, name TEXT NOT NULL, PRIMARY KEY (lang, id));
+         CREATE TABLE character_descriptions (lang TEXT NOT NULL, id INTEGER NOT NULL, description TEXT NOT NULL, PRIMARY KEY (lang, id));
+         CREATE TABLE skill_names            (lang TEXT NOT NULL, id INTEGER NOT NULL, name TEXT NOT NULL, description TEXT, PRIMARY KEY (lang, id));
+         CREATE TABLE series_names           (lang TEXT NOT NULL, id INTEGER NOT NULL, name TEXT NOT NULL, PRIMARY KEY (lang, id));
+         CREATE TABLE team_names             (lang TEXT NOT NULL, id INTEGER NOT NULL, name TEXT NOT NULL, PRIMARY KEY (lang, id));
+         CREATE TABLE item_names             (lang TEXT NOT NULL, id INTEGER NOT NULL, name TEXT NOT NULL, PRIMARY KEY (lang, id));
+         CREATE TABLE item_descriptions      (lang TEXT NOT NULL, id INTEGER NOT NULL, description TEXT NOT NULL, PRIMARY KEY (lang, id));
+         CREATE TABLE character_name_parts   (lang TEXT NOT NULL, id INTEGER NOT NULL, part INTEGER NOT NULL, text TEXT NOT NULL, PRIMARY KEY (lang, id, part));
+         CREATE TABLE place_names            (lang TEXT NOT NULL, id INTEGER NOT NULL, name TEXT NOT NULL, PRIMARY KEY (lang, id));
+         CREATE TABLE location_names         (lang TEXT NOT NULL, id INTEGER NOT NULL, name TEXT NOT NULL, PRIMARY KEY (lang, id));",
+    )?;
+
+    for language in LANGUAGES {
+        let path = Path::new(out_dir).join("text").join(format!("{language}.sqlite"));
+        conn.execute("ATTACH DATABASE ?1 AS t", [path.to_string_lossy()])?;
+
+        for (table, columns) in TEXT_TABLES {
+            conn.execute_batch(&format!(
+                "INSERT INTO {table} (lang, {columns})
+                 SELECT '{language}', {columns} FROM t.{table};"
+            ))?;
+        }
+
+        conn.execute_batch("DETACH DATABASE t;")?;
+    }
+
+    for (table, _) in TEXT_TABLES {
+        let n: i64 = conn.query_row(&format!("SELECT COUNT(*) FROM {table}"), [], |r| r.get(0))?;
+        println!("  {table:<24} {n} rows (all languages)");
+    }
+
+    // Indexes for the lookups an app actually does
+    conn.execute_batch(
+        "CREATE INDEX idx_hissatsu_name        ON hissatsu(name_id);
+         CREATE INDEX idx_aura_hissatsu_name   ON aura_hissatsu(name_id);
+         CREATE INDEX idx_aura_name            ON aura(name_id);
+         CREATE INDEX idx_passive_name         ON passive_skills(name_id);
+         CREATE INDEX idx_passive_string       ON passive_skills(string_id);
+         CREATE INDEX idx_tiers_passive        ON passive_rarity_tiers(passive_id);
+         CREATE INDEX idx_effects_effect       ON passive_skill_effects(effect_id);
+         CREATE INDEX idx_chara_name           ON characters(name_id);
+         CREATE INDEX idx_chara_character_id   ON characters(character_id);
+         CREATE INDEX idx_chara_series         ON characters(series_id);
+         CREATE INDEX idx_chara_team           ON character_teams(team_id);
+         CREATE INDEX idx_chara_element        ON characters(element);
+         CREATE INDEX idx_chara_position       ON characters(main_position);
+         CREATE INDEX idx_text_skill_id        ON skill_names(id);
+         CREATE INDEX idx_text_chara_id        ON character_names(id);",
+    )?;
+
+    conn.execute_batch("ANALYZE; VACUUM;")?;
+
+    println!("\nwritten to {}", target.display());
+    Ok(())
+}
+
+
+
diff --git a/src/bin/patch_character_ids.rs b/src/bin/patch_character_ids.rs
new file mode 100644
index 0000000..44d34a3
--- /dev/null
+++ b/src/bin/patch_character_ids.rs
@@ -0,0 +1,124 @@
+//! Stamp `character_id` (the game string id, e.g. `c01000010`) onto an already
+//! exported `ievr.{lang}.json` bundle without rebuilding the rest of the dump.
+//!
+//! Inazugle's 3D viewer keys models on this id:
+//!   `{"character_id":["c01000010"]}` XOR 0xFF, base64url → `?q=…`
+//!
+//! usage: patch_character_ids <chara_base.cfg.bin> <json_dir>
+
+use std::collections::HashMap;
+use std::env;
+use std::fs;
+use std::path::Path;
+
+use ievr_cfg_bin_editor_core::{Value, parse_database};
+use serde_json::Value as Json;
+
+fn parse_int(value: &Value) -> Option<i32> {
+    match value {
+        Value::Int(v) => Some(*v),
+        Value::UInt(v) => Some(v.cast_signed()),
+        Value::Hash(v) => Some(v.cast_signed()),
+        _ => None,
+    }
+}
+
+fn parse_string(value: &Value) -> Option<String> {
+    match value {
+        Value::String(s) if !s.is_empty() => Some(s.clone()),
+        _ => None,
+    }
+}
+
+fn character_ids(chara_base: &Path) -> HashMap<i64, String> {
+    let bytes = fs::read(chara_base).expect("could not read chara_base");
+    let db = parse_database(&bytes).expect("could not parse chara_base");
+    let table = db
+        .table("CHARA_BASE_INFO_LIST")
+        .expect("CHARA_BASE_INFO_LIST missing");
+
+    let mut map = HashMap::new();
+    for row in table.rows() {
+        if row.values.len() < 3 {
+            continue;
+        }
+        let Some(index) = parse_int(&row.values[2][0]) else { continue };
+        if index <= 0 {
+            continue;
+        }
+        let Some(id) = parse_string(&row.values[1][0]) else { continue };
+        map.insert(index as i64, id);
+    }
+    map
+}
+
+fn patch_array(rows: &mut [Json], ids: &HashMap<i64, String>) -> (usize, usize) {
+    let mut hit = 0;
+    let mut miss = 0;
+    for row in rows {
+        let Some(object) = row.as_object_mut() else { continue };
+        let Some(index) = object.get("id").and_then(Json::as_i64) else {
+            miss += 1;
+            continue;
+        };
+        match ids.get(&index) {
+            Some(character_id) => {
+                object.insert("character_id".into(), Json::String(character_id.clone()));
+                hit += 1;
+            }
+            None => miss += 1,
+        }
+    }
+    (hit, miss)
+}
+
+fn patch_file(path: &Path, ids: &HashMap<i64, String>) {
+    let text = fs::read_to_string(path).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+    let text = text.trim_start_matches('\u{feff}');
+    let mut bundle: Json = serde_json::from_str(text).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+
+    let Some(root) = bundle.as_object_mut() else {
+        panic!("{}: not a JSON object", path.display());
+    };
+
+    for key in ["characters", "heroes", "basaras"] {
+        match root.get_mut(key).and_then(Json::as_array_mut) {
+            Some(rows) => {
+                let (hit, miss) = patch_array(rows, ids);
+                println!("  {key:<12} +{hit} character_id  ({miss} unmatched)");
+            }
+            None => println!("  {key:<12} (absent)"),
+        }
+    }
+
+    let out = serde_json::to_string(&bundle).expect("serialize");
+    fs::write(path, out).unwrap_or_else(|e| panic!("write {}: {e}", path.display()));
+    println!("  wrote {}", path.display());
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 3 {
+        eprintln!("usage: patch_character_ids <chara_base.cfg.bin> <json_dir>");
+        std::process::exit(1);
+    }
+
+    let ids = character_ids(Path::new(&args[1]));
+    println!("{} character ids from {}", ids.len(), args[1]);
+
+    let dir = Path::new(&args[2]);
+    let mut found = false;
+    for lang in ["en", "fr", "ja", "de", "es", "it", "pt", "zh_hans", "zh_hant"] {
+        let path = dir.join(format!("ievr.{lang}.json"));
+        if path.exists() {
+            found = true;
+            println!("{}", path.display());
+            patch_file(&path, &ids);
+        }
+    }
+
+    if !found {
+        eprintln!("no ievr.*.json in {}", dir.display());
+        std::process::exit(1);
+    }
+}
diff --git a/src/bin/png_to_svg.rs b/src/bin/png_to_svg.rs
new file mode 100644
index 0000000..c6566aa
--- /dev/null
+++ b/src/bin/png_to_svg.rs
@@ -0,0 +1,253 @@
+//! Traces monochrome icon PNGs into SVG paths.
+//!
+//! Only silhouettes vectorise usefully: the outline is recovered from the alpha
+//! channel, so a multi-colour sprite would collapse into one flat blob. Images
+//! that are not monochrome are reported and skipped rather than silently
+//! producing a wrong shape.
+
+use std::collections::HashMap;
+use std::env;
+use std::fs::{self, File};
+use std::path::Path;
+
+const ALPHA_CUT: u8 = 128;
+
+struct Image {
+    width: usize,
+    height: usize,
+    pixels: Vec<u8>,
+}
+
+fn read_png(path: &Path) -> Option<Image> {
+    let decoder = png::Decoder::new(File::open(path).ok()?);
+    let mut reader = decoder.read_info().ok()?;
+    let mut buffer = vec![0; reader.output_buffer_size()];
+    let info = reader.next_frame(&mut buffer).ok()?;
+    if info.color_type != png::ColorType::Rgba {
+        return None;
+    }
+    Some(Image {
+        width: info.width as usize,
+        height: info.height as usize,
+        pixels: buffer[..info.buffer_size()].to_vec(),
+    })
+}
+
+/// Spread of hue/'colourfulness' over the opaque pixels. A white or single
+/// tone silhouette scores near zero.
+fn colour_spread(image: &Image) -> f64 {
+    let mut count = 0u64;
+    let mut sum = 0u64;
+
+    for chunk in image.pixels.chunks_exact(4) {
+        if chunk[3] < ALPHA_CUT {
+            continue;
+        }
+        let (r, g, b) = (chunk[0] as i32, chunk[1] as i32, chunk[2] as i32);
+        let max = r.max(g).max(b);
+        let min = r.min(g).min(b);
+        sum += (max - min) as u64;
+        count += 1;
+    }
+
+    if count == 0 { 0.0 } else { sum as f64 / count as f64 }
+}
+
+type Point = (i32, i32);
+
+/// Some icons are a solid light plate carrying a dark figure. Their alpha is
+/// uniform, so tracing it would yield only the plate — the figure has to come
+/// from luminance instead.
+fn dark_on_light(image: &Image) -> bool {
+    let (mut dark, mut opaque) = (0u64, 0u64);
+
+    for chunk in image.pixels.chunks_exact(4) {
+        if chunk[3] < ALPHA_CUT {
+            continue;
+        }
+        opaque += 1;
+        let luma = 0.299 * chunk[0] as f64 + 0.587 * chunk[1] as f64 + 0.114 * chunk[2] as f64;
+        if luma < 128.0 {
+            dark += 1;
+        }
+    }
+
+    let total = (image.width * image.height) as u64;
+    opaque * 100 > total * 80 && dark * 100 > opaque * 5
+}
+
+/// Boundary edges around the inked area, wound consistently so they chain into
+/// closed loops. "Ink" is transparency for cut-out icons, darkness for plates.
+fn boundary_loops(image: &Image, by_luma: bool) -> Vec<Vec<Point>> {
+    let (w, h) = (image.width, image.height);
+    let opaque = |x: i32, y: i32| -> bool {
+        if x < 0 || y < 0 || x >= w as i32 || y >= h as i32 {
+            return false;
+        }
+        if by_luma {
+            let at = (y as usize * w + x as usize) * 4;
+            let p = &image.pixels[at..at + 4];
+            let luma = 0.299 * p[0] as f64 + 0.587 * p[1] as f64 + 0.114 * p[2] as f64;
+            return p[3] >= ALPHA_CUT && luma < 128.0;
+        }
+        image.pixels[(y as usize * w + x as usize) * 4 + 3] >= ALPHA_CUT
+    };
+
+    // A vertex where two shapes touch diagonally starts two edges, so the
+    // outgoing edges have to be a list — keying one per point drops geometry.
+    let mut edges: HashMap<Point, Vec<Point>> = HashMap::new();
+    let mut add = |from: Point, to: Point, edges: &mut HashMap<Point, Vec<Point>>| {
+        edges.entry(from).or_default().push(to);
+    };
+
+    for y in 0..h as i32 {
+        for x in 0..w as i32 {
+            if !opaque(x, y) {
+                continue;
+            }
+            if !opaque(x, y - 1) { add((x, y), (x + 1, y), &mut edges); }
+            if !opaque(x + 1, y) { add((x + 1, y), (x + 1, y + 1), &mut edges); }
+            if !opaque(x, y + 1) { add((x + 1, y + 1), (x, y + 1), &mut edges); }
+            if !opaque(x - 1, y) { add((x, y + 1), (x, y), &mut edges); }
+        }
+    }
+
+    let mut loops = Vec::new();
+    loop {
+        let Some(start) = edges
+            .iter()
+            .find(|(_, outgoing)| !outgoing.is_empty())
+            .map(|(point, _)| *point)
+        else {
+            break;
+        };
+
+        let mut loop_points = vec![start];
+        let mut current = start;
+
+        loop {
+            let Some(outgoing) = edges.get_mut(&current) else { break };
+            let Some(next) = outgoing.pop() else { break };
+
+            if next == start {
+                break;
+            }
+            loop_points.push(next);
+            current = next;
+        }
+
+        if loop_points.len() >= 4 {
+            loops.push(loop_points);
+        }
+    }
+
+    loops
+}
+
+fn perpendicular_distance(p: Point, a: Point, b: Point) -> f64 {
+    let (px, py) = (p.0 as f64, p.1 as f64);
+    let (ax, ay) = (a.0 as f64, a.1 as f64);
+    let (bx, by) = (b.0 as f64, b.1 as f64);
+    let (dx, dy) = (bx - ax, by - ay);
+    let len = (dx * dx + dy * dy).sqrt();
+    if len == 0.0 {
+        return ((px - ax).powi(2) + (py - ay).powi(2)).sqrt();
+    }
+    ((dx * (ay - py) - (ax - px) * dy) / len).abs()
+}
+
+fn simplify(points: &[Point], epsilon: f64) -> Vec<Point> {
+    if points.len() < 3 {
+        return points.to_vec();
+    }
+
+    let (mut index, mut furthest) = (0usize, 0.0f64);
+    let last = points.len() - 1;
+    for i in 1..last {
+        let d = perpendicular_distance(points[i], points[0], points[last]);
+        if d > furthest {
+            furthest = d;
+            index = i;
+        }
+    }
+
+    if furthest > epsilon {
+        let mut left = simplify(&points[..=index], epsilon);
+        let right = simplify(&points[index..], epsilon);
+        left.pop();
+        left.extend(right);
+        left
+    } else {
+        vec![points[0], points[last]]
+    }
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 3 {
+        eprintln!("usage: png_to_svg <in_dir> <out_dir> [epsilon] [max_colour_spread]");
+        std::process::exit(1);
+    }
+
+    let epsilon: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(0.8);
+    let max_spread: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(24.0);
+
+    let in_dir = Path::new(&args[1]);
+    let out_dir = Path::new(&args[2]);
+    fs::create_dir_all(out_dir).expect("create out dir");
+
+    let mut files: Vec<_> = fs::read_dir(in_dir)
+        .expect("read in dir")
+        .flatten()
+        .map(|e| e.path())
+        .filter(|p| p.extension().is_some_and(|e| e == "png"))
+        .collect();
+    files.sort();
+
+    let (mut traced, mut skipped) = (0, 0);
+
+    for file in &files {
+        let Some(image) = read_png(file) else { continue };
+
+        let by_luma = dark_on_light(&image);
+
+        let spread = colour_spread(&image);
+        if !by_luma && spread > max_spread {
+            skipped += 1;
+            println!("  skip  {:<28} colour spread {:.1}", file.file_name().unwrap().to_string_lossy(), spread);
+            continue;
+        }
+
+        let paths: Vec<String> = boundary_loops(&image, by_luma)
+            .iter()
+            .map(|points| simplify(points, epsilon))
+            .filter(|points| points.len() >= 3)
+            .map(|points| {
+                let mut d = format!("M{} {}", points[0].0, points[0].1);
+                for p in &points[1..] {
+                    d.push_str(&format!("L{} {}", p.0, p.1));
+                }
+                d.push('Z');
+                d
+            })
+            .collect();
+
+        if paths.is_empty() {
+            skipped += 1;
+            continue;
+        }
+
+        let svg = format!(
+            "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {} {}\" fill=\"currentColor\" fill-rule=\"evenodd\"><path d=\"{}\"/></svg>",
+            image.width,
+            image.height,
+            paths.join("")
+        );
+
+        let target = out_dir.join(file.file_stem().unwrap()).with_extension("svg");
+        fs::write(&target, svg).expect("write svg");
+        traced += 1;
+    }
+
+    println!("\n{traced} traced, {skipped} skipped");
+}
diff --git a/src/bin/show_table.rs b/src/bin/show_table.rs
new file mode 100644
index 0000000..b56505e
--- /dev/null
+++ b/src/bin/show_table.rs
@@ -0,0 +1,58 @@
+use std::env;
+use std::fs;
+
+use ievr_cfg_bin_editor_core::{Value, parse_database};
+
+fn render(v: &Value) -> String {
+    match v {
+        Value::Bool(x) => format!("B:{x}"),
+        Value::Byte(x) => format!("u8:{x}"),
+        Value::Int(x) => format!("i:{x}"),
+        Value::Long(x) => format!("l:{x}"),
+        Value::Short(x) => format!("s:{x}"),
+        Value::UInt(x) => format!("u:{x}"),
+        Value::Float(x) => format!("f:{x}"),
+        Value::FloatLong(x) => format!("d:{x}"),
+        Value::String(x) => format!("\"{x}\""),
+        Value::Hash(x) => format!("h:{x}"),
+        Value::Bytes(x) => format!("<{}b>", x.len()),
+        Value::Tuple2I16(a, b) => format!("({a},{b})"),
+        Value::Vec4F32(x) => format!("{x:?}"),
+    }
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 3 {
+        eprintln!("usage: show_table <file.cfg.bin> <table> [rows] [skip]");
+        std::process::exit(1);
+    }
+
+    let take: usize = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(10);
+    let skip: usize = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(0);
+
+    let bytes = fs::read(&args[1]).expect("could not read file");
+    let db = parse_database(&bytes).expect("could not parse");
+
+    let Some(table) = db.table(&args[2]) else {
+        eprintln!("table not found");
+        std::process::exit(1);
+    };
+
+    println!("{} : {} rows", table.name(), table.rows().len());
+
+    let mut widths = std::collections::BTreeMap::new();
+    for row in table.rows() {
+        *widths.entry(row.values.len()).or_insert(0usize) += 1;
+    }
+    println!("column counts: {widths:?}\n");
+
+    for row in table.rows().iter().skip(skip).take(take) {
+        let cells: Vec<String> = row
+            .values
+            .iter()
+            .map(|col| col.iter().map(render).collect::<Vec<_>>().join("/"))
+            .collect();
+        println!("{:<38} {}", row.name, cells.join("  "));
+    }
+}
diff --git a/src/bin/slice_atlas.rs b/src/bin/slice_atlas.rs
new file mode 100644
index 0000000..70fd81f
--- /dev/null
+++ b/src/bin/slice_atlas.rs
@@ -0,0 +1,145 @@
+//! Slices a sprite atlas PNG into individual icons.
+//!
+//! The game ships icons as sheets with no coordinates in the texture itself, so
+//! sprites are recovered from the alpha channel: opaque pixels are dilated so
+//! the parts of one icon join up, connected components are labelled, and each
+//! component's bounding box is cropped out of the original image.
+
+use std::collections::VecDeque;
+use std::env;
+use std::fs::{self, File};
+use std::io::BufWriter;
+use std::path::Path;
+
+const ALPHA_FLOOR: u8 = 16;
+
+struct Image {
+    width: usize,
+    height: usize,
+    pixels: Vec<u8>, // RGBA
+}
+
+fn read_png(path: &Path) -> Image {
+    let decoder = png::Decoder::new(File::open(path).expect("open"));
+    let mut reader = decoder.read_info().expect("png header");
+    let mut buffer = vec![0; reader.output_buffer_size()];
+    let info = reader.next_frame(&mut buffer).expect("png data");
+
+    assert!(info.color_type == png::ColorType::Rgba, "expected RGBA");
+
+    Image {
+        width: info.width as usize,
+        height: info.height as usize,
+        pixels: buffer[..info.buffer_size()].to_vec(),
+    }
+}
+
+/// Opaque mask, dilated by `radius` so one icon's disconnected parts merge.
+fn dilated_mask(image: &Image, radius: isize) -> Vec<bool> {
+    let (w, h) = (image.width, image.height);
+    let mut mask = vec![false; w * h];
+
+    for y in 0..h {
+        for x in 0..w {
+            if image.pixels[(y * w + x) * 4 + 3] < ALPHA_FLOOR {
+                continue;
+            }
+            for dy in -radius..=radius {
+                for dx in -radius..=radius {
+                    let nx = x as isize + dx;
+                    let ny = y as isize + dy;
+                    if nx >= 0 && ny >= 0 && (nx as usize) < w && (ny as usize) < h {
+                        mask[ny as usize * w + nx as usize] = true;
+                    }
+                }
+            }
+        }
+    }
+
+    mask
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 3 {
+        eprintln!("usage: slice_atlas <atlas.png> <out_dir> [dilate] [min_size]");
+        std::process::exit(1);
+    }
+
+    let radius: isize = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(3);
+    let min_size: usize = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(12);
+
+    let source = Path::new(&args[1]);
+    let out_dir = Path::new(&args[2]);
+    fs::create_dir_all(out_dir).expect("create out dir");
+
+    let image = read_png(source);
+    let (w, h) = (image.width, image.height);
+    let mask = dilated_mask(&image, radius);
+
+    let stem = source.file_stem().unwrap().to_string_lossy().to_string();
+    let mut seen = vec![false; w * h];
+    let mut boxes = Vec::new();
+
+    for start in 0..w * h {
+        if !mask[start] || seen[start] {
+            continue;
+        }
+
+        let (mut x0, mut y0, mut x1, mut y1) = (w, h, 0usize, 0usize);
+        let mut queue = VecDeque::new();
+        queue.push_back(start);
+        seen[start] = true;
+
+        while let Some(index) = queue.pop_front() {
+            let (x, y) = (index % w, index / w);
+            x0 = x0.min(x);
+            y0 = y0.min(y);
+            x1 = x1.max(x);
+            y1 = y1.max(y);
+
+            let mut push = |nx: usize, ny: usize, queue: &mut VecDeque<usize>, seen: &mut Vec<bool>| {
+                let n = ny * w + nx;
+                if mask[n] && !seen[n] {
+                    seen[n] = true;
+                    queue.push_back(n);
+                }
+            };
+
+            if x > 0 { push(x - 1, y, &mut queue, &mut seen) }
+            if y > 0 { push(x, y - 1, &mut queue, &mut seen) }
+            if x + 1 < w { push(x + 1, y, &mut queue, &mut seen) }
+            if y + 1 < h { push(x, y + 1, &mut queue, &mut seen) }
+        }
+
+        if x1 - x0 + 1 >= min_size && y1 - y0 + 1 >= min_size {
+            boxes.push((x0, y0, x1, y1));
+        }
+    }
+
+    // Reading order, so the numbering matches how the sheet looks
+    boxes.sort_by_key(|(x0, y0, _, _)| (y0 / 32, *x0));
+
+    for (n, (x0, y0, x1, y1)) in boxes.iter().enumerate() {
+        let (bw, bh) = (x1 - x0 + 1, y1 - y0 + 1);
+        let mut crop = Vec::with_capacity(bw * bh * 4);
+
+        for y in *y0..=*y1 {
+            let row = (y * w + x0) * 4;
+            crop.extend_from_slice(&image.pixels[row..row + bw * 4]);
+        }
+
+        let target = out_dir.join(format!("{stem}_{n:03}.png"));
+        let file = File::create(&target).expect("create png");
+        let mut encoder = png::Encoder::new(BufWriter::new(file), bw as u32, bh as u32);
+        encoder.set_color(png::ColorType::Rgba);
+        encoder.set_depth(png::BitDepth::Eight);
+        encoder
+            .write_header()
+            .expect("header")
+            .write_image_data(&crop)
+            .expect("data");
+    }
+
+    println!("{}: {} sprites", stem, boxes.len());
+}
