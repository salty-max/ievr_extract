+    let rarity_table_config = parse_gamefile(&root_path.join(&requested_files["passive_skill_rarity_table_config"])).unwrap();
+
+    let rarity_table_list = rarity_table_config.table("m_passiveSkillRarityTableList").unwrap();
+
+    let mut tier_buffer = Vec::with_capacity(rarity_table_list.rows().len() * PassiveTier::SLOTS);
+    for (family_index, row) in rarity_table_list.rows().iter().enumerate() {
+        for (tier, value) in row.values[0].iter().enumerate() {
+            let passive_id = parse_id_value(value);
+
+            // The id list is zero padded up to PassiveTier::SLOTS
+            if passive_id != 0 {
+                tier_buffer.push(PassiveTier {
+                    family_index: family_index as i32,
+                    tier: tier as i32,
+                    passive_id,
+                });
+            }
+        }
+    }
+
+    insert_passive_tiers(&mut skill_database_connection, &tier_buffer).unwrap();
+
+    let tactics_config = parse_gamefile(&root_path.join(&requested_files["special_tactics_config"])).unwrap();
+    let tactics_list = tactics_config.table("SPECIAL_TACTICS_INFO_LIST").unwrap();
+
+    let tactics: Vec<Tactic> = tactics_list
+        .rows()
+        .iter()
+        .filter(|row| row.name == Tactic::ROW && row.values.len() == Tactic::COLUMNS)
+        .map(Tactic::from)
+        .collect();
+
+    insert_tactics(&mut skill_database_connection, &tactics).unwrap();
+
+    // Synergies and equipment are filed as items, so they live in item_config,
+    // one directory over from the skill configs.
+    let item_root = extraction_path.to_path_buf().join(ITEM_ROOT_PATH);
+    let item_config = std::fs::read_dir(&item_root)
+        .ok()
+        .and_then(|entries| {
+            entries.flatten().find(|e| {
+                e.file_name().to_string_lossy().starts_with("item_config_")
+            })
+        })
+        .and_then(|entry| parse_gamefile(&entry.path()));
+
+    let synergies = item_config
+        .as_ref()
+        .and_then(|config| {
+            config.table("ITEM_SYNERGY_FLAG_INFO_LIST").map(|table| {
+                table
+                    .rows()
+                    .iter()
+                    .filter(|row| row.name == Synergy::ROW && row.values.len() == Synergy::COLUMNS)
+                    .map(Synergy::from)
+                    .collect::<Vec<_>>()
+            })
+        })
+        .unwrap_or_default();
+
+    insert_synergies(&mut skill_database_connection, &synergies).unwrap();
+
+    let mut equipment = Vec::new();
+    if let Some(config) = item_config.as_ref() {
+        for (table_name, slot, info_row, stat_row) in Equipment::SLOTS {
+            let Some(table) = config.table(table_name) else { continue };
+
+            for row in table.rows() {
+                if row.name == info_row && row.values.len() == Equipment::COLUMNS {
+                    equipment.push(Equipment::from_row(row, slot));
+                } else if row.name == stat_row {
+                    if let Some(item) = equipment.last_mut() {
+                        item.read_stats(row);
+                    }
+                }
+            }
+        }
+    }
+
+    insert_equipment(&mut skill_database_connection, &equipment).unwrap();
+
+    println!(
+        "[ITEMS]: {} tactics, {} synergies, {} equipment.",
+        tactics.len(),
+        synergies.len(),
+        equipment.len()
+    );
 }
 
