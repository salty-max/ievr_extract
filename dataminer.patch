+++ b/src/bin/dbstat.rs
@@ -0,0 +1,50 @@
+use std::env;
+
+use rusqlite::Connection;
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 2 {
+        eprintln!("usage: dbstat <db.sqlite> [sql]");
+        std::process::exit(1);
+    }
+
+    let conn = Connection::open(&args[1]).expect("open failed");
+
+    if let Some(sql) = args.get(2) {
+        let mut stmt = conn.prepare(sql).expect("bad sql");
+        let cols: Vec<String> = stmt.column_names().iter().map(|s| s.to_string()).collect();
+        println!("{}", cols.join(" | "));
+        let n = cols.len();
+        let mut rows = stmt.query([]).unwrap();
+        while let Some(row) = rows.next().unwrap() {
+            let vals: Vec<String> = (0..n)
+                .map(|i| match row.get_ref(i).unwrap() {
+                    rusqlite::types::ValueRef::Null => "NULL".to_string(),
+                    rusqlite::types::ValueRef::Integer(v) => v.to_string(),
+                    rusqlite::types::ValueRef::Real(v) => format!("{v}"),
+                    rusqlite::types::ValueRef::Text(v) => String::from_utf8_lossy(v).to_string(),
+                    rusqlite::types::ValueRef::Blob(v) => format!("<{} bytes>", v.len()),
+                })
+                .collect();
+            println!("{}", vals.join(" | "));
+        }
+        return;
+    }
+
+    let mut stmt = conn
+        .prepare("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
+        .unwrap();
+    let names: Vec<String> = stmt
+        .query_map([], |r| r.get::<_, String>(0))
+        .unwrap()
+        .map(|r| r.unwrap())
+        .collect();
+
+    for name in names {
+        let count: i64 = conn
+            .query_row(&format!("SELECT COUNT(*) FROM \"{name}\""), [], |r| r.get(0))
+            .unwrap_or(-1);
+        println!("  {name:<26} {count} rows");
+    }
+}
