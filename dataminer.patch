+/// Hash columns come back as unsigned, plain id columns as signed.
+pub fn parse_id_value(value: &Value) -> i32 {
+    match value {
+        Value::UInt(v) => v.cast_signed(),
+        Value::Hash(v) => v.cast_signed(),
+        Value::Int(v) => *v,
+        _ => unreachable!()
+    }
+}
+
+/// T2B stores whole numbers as integers, so a numeric column is not
+/// guaranteed to hold the same variant on every row.
+pub fn parse_number_value(value: &Value) -> f32 {
+    match value {
+        Value::Float(v) => *v,
+        Value::FloatLong(v) => *v as f32,
+        Value::Int(v) => *v as f32,
+        Value::Long(v) => *v as f32,
+        _ => unreachable!()
+    }
+}
